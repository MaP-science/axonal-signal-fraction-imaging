{
    "root": "..",
    "experiment": "asfimaging_hcp_slice",
  
    "data_paths": {
      "dwi": "data/hcp/dwi_DGE.nii.gz",
      "bvals": "data/hcp/bvals.txt",
      "bvecs": "data/hcp/bvecs.txt",
      "mask": "data/hcp/new_dwi_bet_mask_mask_cut.nii.gz",
      "ODF": "asfimaging/sh_descoteaux/odf_checked.npy",
      "scheme": "data/hcp/scheme.pkl"
    },
  
    "real_data_acquisition": {
      "high_bmin": 5000e6,
      "high_bmax": 10000e6,
      "tolerance_bval": 100e6,
      "tolerance_b0": 45e6,
      "TE": 0.057, 
      "delta": 0.0129,
      "Delta": 0.0218, 
      "sh_order": 12
    },
  
    "real_data_preprocessing": {
      "noise_distribution": "gaussian", 
      "enforce_non_negativity": true,
      "sh_lambda_reg": 0.0,
      "n_jobs": 12
    },

    "synthetic_data_parameters": {
      "N_signals": 20000,
      "N_signals_test": 2000,
      "random_seed_train": 1234,
      "random_seed_test": 5678,
      "n_jobs": 12,
      "alphas_dirichlet": [1,1,1],
      "snr": [5,200], 
      "t2_intra_lower": 0.030,
      "t2_intra_upper": 0.150,
      "t2_extra_lower": 0.030,
      "t2_extra_upper": 0.300,
      "t2_dot": 0.060,
      "t2_gm_lower": 0.040,
      "t2_gm_upper": 0.150,
      "t2_csf": 2,
      "intra_dpar_lower": 0.1e-9,
      "intra_dpar_upper": 3.0e-9,
      "intra_dperp_lower": 0,
      "intra_dperp_upper": 0.05e-9,
      "extra_diff_lower": 0.6e-9,
      "extra_diff_upper": 3.0e-9,
      "csf_diso_lower": 2.95e-9,
      "csf_diso_upper": 3.1e-9,
      "gm_diso_lower": 0.70e-9,
      "gm_diso_upper": 1.0e-9,
      "dot_diso": 0.1e-11,
      "relative_vf_dot": 0.0
    },

    "features_labels": {
        "zonal_ratios": true,
        "sphm_high_b_lower": false,
        "sphm_high_b_upper": false,
        "sphvar_high_b_lower": false,
        "sphvar_high_b_upper": false,
        "spectra_high_b_lower": true,
        "spectra_high_b_upper": false, 
        "predicted_asf": false
    },

    "RF_model_parameters": {
      "n_estimators": 200,
      "max_depth": 20,
      "min_samples_split": 2,
      "min_samples_leaf": 2,
      "max_features": "sqrt",
      "bootstrap": true,
      "oob_score": true,
      "criterion": "squared_error",
      "random_state": 1234, 
      "n_jobs": 12
    },
  
    "mapping": {
      "synthetic_data": "data/synthetic_data",
      "model_path": "data/hcp/model/RF_model.joblib",
      "scaler_path": "data/hcp/model/RF_scaler.joblib",
      "labels_path": "data/hcp/results/RF_labels.npy",
      "features_dir": "data/hcp/results/features",
      "maps_dir": "data/hcp/results/maps",
      "slices_dir": "data/hcp/results"
    }
  }
